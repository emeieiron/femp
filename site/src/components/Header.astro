---
import Logo from './Logo.astro';
import ThemeToggle from './ThemeToggle.astro';
import { repo, url } from '../lib/site';

interface Props {
  current?: 'home' | 'docs';
}

const { current } = Astro.props;
---

<header class="header">
  <div class="inner">
    <a class="home" href={url()} aria-label="FeMP home">
      <Logo />
    </a>
    <nav aria-label="Main">
      <a href={url('docs/overview/')} aria-current={current === 'docs' ? 'page' : undefined}>Docs</a>
      <a class="wide-only" href={url('docs/quick-start/')}>Quick start</a>
      <a class="wide-only" href={url('docs/proving/')}>Proving</a>
      <a class="wide-only" href={url('docs/cli/')}>CLI</a>
      <a class="github" href={repo} aria-label="FeMP on GitHub">
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path
            d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.52-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.25 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"
          ></path>
        </svg>
        <span class="wide-only">GitHub</span>
      </a>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    border-bottom: 1px solid var(--line);
    background: var(--bg-glass);
    backdrop-filter: saturate(1.4) blur(14px);
    -webkit-backdrop-filter: saturate(1.4) blur(14px);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 100%;
    width: min(100% - 2 * var(--gutter), 1440px);
    margin-inline: auto;
  }

  .home {
    text-decoration: none;
  }

  nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  nav a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 40px;
    padding: 0 12px;
    border-radius: var(--radius);
    color: var(--fg-muted);
    font-size: 0.92rem;
    font-weight: 500;
    text-decoration: none;
    transition:
      color 140ms ease,
      background-color 140ms ease;
  }

  nav a:hover,
  nav a[aria-current='page'] {
    color: var(--fg);
  }

  nav a[aria-current='page'] {
    background: var(--bg-raised);
  }

  .github svg {
    width: 18px;
    height: 18px;
    fill: currentColor;
  }

  nav :global(.theme-toggle) {
    margin-left: 6px;
  }

  @media (max-width: 720px) {
    nav .wide-only {
      display: none;
    }

    nav a {
      padding: 0 10px;
    }
  }
</style>
