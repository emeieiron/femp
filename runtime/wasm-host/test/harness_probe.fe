// A property harness in the shape FeMP generates, for the runner's tests.
// `harness_probe.wasm` and `harness_probe.manifest.json` are built from it:
//
//   fe build --backend wasm --out-dir runtime/wasm-host/test runtime/wasm-host/test/harness_probe.fe
use std::wasm::{HostText, Log}
use std::wasm::files::{Files, Handle, close, open, read_byte}

pub fn femp_entry_0(femp_arg0: u64, femp_arg1: bool) -> bool {
    femp_arg1 || femp_arg0 < 10
}

pub fn femp_entry_1(femp_arg0: i8) -> i8 {
    0 - femp_arg0
}

fn femp_word(_ handle: Handle, _ index: u32) -> u64 uses (files: mut Files) {
    var value: u64 = 0
    var byte_index: u32 = 0
    while byte_index < 8 {
        match read_byte(handle, index * 8 + byte_index) {
            Result::Ok(byte) => {
                value = value | ((byte as u64) << ((byte_index * 8) as u64))
            },
            Result::Err(_) => core::panic(),
        }
        byte_index += 1
    }
    value
}

// A counter that starts at its argument; command 0 adds, command 1 halves.
pub fn femp_entry_2(script: HostText) -> u32 uses (files: mut Files, log: mut Log) {
    let handle = match open(script.copy()) {
        Result::Ok(handle) => handle,
        Result::Err(_) => core::panic(),
    }
    var counter: u64 = femp_word(handle, 0)
    log.log_i32(value: 0)
    log.log_u64(value: counter)
    let steps = femp_word(handle, 1)
    var cursor: u32 = 2
    var step: u64 = 0
    while step < steps {
        let command = femp_word(handle, cursor)
        cursor += 1
        if command == 0 {
            counter = counter + femp_word(handle, cursor)
            cursor += 1
        } else {
            counter = counter / 2
        }
        log.log_i32(value: 0)
        log.log_u64(value: counter)
        step += 1
    }
    close(handle)
    0
}
