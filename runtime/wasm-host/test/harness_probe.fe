// A property harness in the shape FeMP generates, for the runner's tests.
// `harness_probe.wasm` and `harness_probe.manifest.json` are built from it.
use core::MemBuffer
use core::text::{parse_int, parse_uint}
use std::io::{Stdin, StdinReader, Stdout}

fn femp_line(_ reader: mut StdinReader) -> Option<MemBuffer> uses (input: mut Stdin) {
    var text = MemBuffer::empty()
    if reader.read_line(mut text) {
        Option::Some(text)
    } else {
        Option::None
    }
}

fn femp_uint(_ reader: mut StdinReader) -> u256 uses (input: mut Stdin) {
    match femp_line(mut reader) {
        Option::Some(text) => match parse_uint(text) {
            Option::Some(value) => value,
            Option::None => core::panic(),
        },
        Option::None => core::panic(),
    }
}

fn femp_int(_ reader: mut StdinReader) -> i256 uses (input: mut Stdin) {
    match femp_line(mut reader) {
        Option::Some(text) => match parse_int(text) {
            Option::Some(value) => value,
            Option::None => core::panic(),
        },
        Option::None => core::panic(),
    }
}

#[unsafe(export)]
pub fn femp_entry_0() uses (input: mut Stdin, out: mut Stdout) {
    var reader = StdinReader::new()
    let femp_arg0: u64 = femp_uint(mut reader).downcast_unchecked()
    let femp_arg1: bool = femp_uint(mut reader) == 1
    println!(femp_arg1 || femp_arg0 < 10)
}

#[unsafe(export)]
pub fn femp_entry_1() uses (input: mut Stdin, out: mut Stdout) {
    var reader = StdinReader::new()
    let femp_arg0: i8 = femp_int(mut reader).downcast_unchecked()
    println!(0 - femp_arg0)
}

// Wide 256-bit arithmetic crossing the stream boundary.
#[unsafe(export)]
pub fn femp_entry_2() uses (input: mut Stdin, out: mut Stdout) {
    var reader = StdinReader::new()
    let femp_arg0: u256 = femp_uint(mut reader)
    let femp_arg1: u256 = femp_uint(mut reader)
    println!(femp_arg0 + femp_arg1)
}

// A counter that starts at its argument; command 0 adds, command 1 halves.
#[unsafe(export)]
pub fn femp_entry_3() uses (input: mut Stdin, out: mut Stdout) {
    var reader = StdinReader::new()
    var counter: u256 = femp_uint(mut reader)
    println!("@")
    println!(counter)
    let steps = femp_uint(mut reader)
    var step: u256 = 0
    while step < steps {
        let command = femp_uint(mut reader)
        if command == 0 {
            counter = counter + femp_uint(mut reader)
        } else {
            counter = counter / 2
        }
        println!("@")
        println!(counter)
        step += 1
    }
}
